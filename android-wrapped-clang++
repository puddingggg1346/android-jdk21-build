#!/bin/bash
if [ "$1" = "--version" ]; then
  echo "${TARGET}-g++ (GCC) 4.9 20140827 (prerelease)"
else
  case " $* " in
    *" -shared "*|*" -o "*)
      exec $thecxx -Wno-unknown-warning-option -Wl,--unresolved-symbols=ignore-all -ldl "${@/-fno-var-tracking-assignments/}"
      ;;
    *)
      exec $thecxx -Wno-unknown-warning-option "${@/-fno-var-tracking-assignments/}"
      ;;
  esac
fi
